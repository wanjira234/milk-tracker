# Copy to .env and fill in. Never commit .env.

# Password for the app's login screen. Required: with none set, the app stays locked.
APP_PASSWORD=
# Your own phone (0712... or +254...). Logging in with an SMS code from this number creates the admin account.
ADMIN_PHONE=

# Supabase Postgres connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/milk_tracker

# Throwaway database for tests only. Tests TRUNCATE tables: never use production.
TEST_DATABASE_URL=

# Claude API (Haiku writes the SMS wording)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# Africa's Talking (use username "sandbox" while testing)
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=
