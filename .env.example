# Copy to .env and fill in. Never commit .env.

# Supabase Postgres connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/milk_tracker

# Throwaway database for tests only. Tests TRUNCATE tables: never use production.
TEST_DATABASE_URL=

# Claude API (Haiku writes the SMS wording)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5

# Africa's Talking (use username "sandbox" while testing)
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=
